Board col gap5 p6 w1200 fill:canvas
  Row1 row gap4 wfill
    Card1 col gap3 p5 wfill fill:surface stroke:border rcard
      @Chart kind=column w520 h240 data="42,51,48,60,57,66,63;6,4,9,3,5,2,4" labels="Mon|Tue|Wed|Thu|Fri|Sat|Sun" series="Passed|Failed" "Runs this week"
    Card2 col gap3 p5 wfill fill:surface stroke:border rcard
      @Chart kind=line w520 h240 data="94.1,95.3,93.8,96.2,96.9,97.4,98.1" labels="Mon|Tue|Wed|Thu|Fri|Sat|Sun" unit="%" "Pass rate"
  Row2 row gap4 wfill
    Card3 col gap3 p5 wfill fill:surface stroke:border rcard
      @Chart kind=bar w360 h220 data="38,27,19,11,6" labels="Checkout|Search|Login|Profile|Admin" "Flaky tests by suite"
    Card4 col gap3 p5 wfill fill:surface stroke:border rcard
      @Chart kind=donut w360 h200 data="812,64,23,41" labels="Passed|Failed|Flaky|Skipped" total="tests" "Last run"
    Card5 col gap3 p5 wfill fill:surface stroke:border rcard
      @Chart kind=stacked w360 h220 data="20,24,22,30;5,3,6,4;2,1,3,2" labels="W1|W2|W3|W4" series="Unit|E2E|Visual" "Suites added"
  Row3 row gap4 wfill
    Card6 col gap3 p5 wfill fill:surface stroke:border rcard
      @Chart kind=heatmap w520 h180 data="2,5,9,4,1,0,3;8,12,15,9,6,2,4;3,4,7,11,14,9,5" labels="00|04|08|12|16|20|24" series="Checkout|Search|Login" "Failures by hour"
    Card7 col gap4 p5 wfill fill:surface stroke:border rcard
      @Meter value=58 "CPU"
      @Meter value=81 "Storage"
      @Meter value=94 unit=" GB" max=100 "Memory"
      Gauges row gap6
        @Meter shape=gauge value=42 "Queue"
        @Meter shape=gauge value=93 "Error budget used"
      Spark row gap3 center
        Text body-sm "Trend"
        @Sparkline data="4,6,5,8,7,9,8,11,10,12,11,14"
        @Sparkline area=true data="9,8,8,7,9,6,5,6,4,5,3,2"
  Row4 row gap4 wfill
    Card8 col gap4 p5 wfill fill:surface stroke:border rcard
      @CodeBlock lang=ts title="checkout.spec.ts" highlight=3 "import { test, expect } from '@playwright/test';\n\ntest('applies coupon', async ({ page }) => {\n  await page.goto('/cart'); // seeded cart\n  await expect(page.getByText('$42.00')).toBeVisible();\n});"
      Inputs row gap3 center wrap
        @NumberInput value=3 min=1 max=10 unit="×"
        @OTP value="482"
        @AvatarGroup names="Asha Rao|Ben Ortiz|Chen Wei|Dana Kim|Eli Shah|Fay Lim"
      @TagInput tags="smoke|checkout|mobile" "Add label…"
    Card9 col gap4 p5 w300 fill:surface stroke:border rcard
      @ColorPicker value=#d9900f
  Row5 row gap4 wfill
    @Video duration="12:08" progress=20 "Writing stable selectors"
    @Carousel count=5 selected=2
      Text title "Run tests from your phone"
      Text body muted "Get pinged when a nightly run fails."
