App row w1440 h900 fill:canvas clip name:"Test runs — app"
  +sidebar-nav selected=2
  Main col wfill hfill
    +topbar
    Content col gap6 p6 wfill
      +page-header title="Test runs" subtitle="Nightly and on-demand runs across all suites" crumbs="Checkout/Runs"
      +stats
      +toolbar
      +table cols="Run|Status|Owner|Duration|Started" rows=6 select=true
