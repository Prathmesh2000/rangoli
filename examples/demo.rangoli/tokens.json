  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": "0 1px 2px rgba(16,24,40,.06), 0 1px 3px rgba(16,24,40,.10)",
      "$extensions": {
        "rangoli": {
          "modes": {
            "dark": "0 1px 2px rgba(0,0,0,.4)"
          }
        }
      }
    },
    "md": {
      "$value": "0 4px 8px -2px rgba(16,24,40,.08), 0 2px 4px -2px rgba(16,24,40,.06)",
      "$extensions": {
        "rangoli": {
          "modes": {
            "dark": "0 4px 8px rgba(0,0,0,.45)"
          }
        }
      }
    },
    "lg": {
      "$value": "0 12px 16px -4px rgba(16,24,40,.08), 0 4px 6px -2px rgba(16,24,40,.03)",
      "$extensions": {
        "rangoli": {
          "modes": {
            "dark": "0 12px 24px rgba(0,0,0,.5)"
          }
        }
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": {
        "$value": 0
      },
      "fast": {
        "$value": 120,
        "$extensions": {
          "rangoli": {
            "modes": {
              "reduced": 0
            }
          }
        }
      },
      "base": {
        "$value": 200,
        "$extensions": {
          "rangoli": {
            "modes": {
              "reduced": 0
            }
          }
        }
      },
      "slow": {
        "$value": 300,
        "$extensions": {
          "rangoli": {
            "modes": {
              "reduced": 0
            }
          }
        }
      },
      "panel": {
        "$value": 350,
        "$extensions": {
          "rangoli": {
            "modes": {
              "reduced": 0
            }
          }
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": {
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      },
      "in": {
        "$value": [
          0.3,
          0,
          0.8,
          0.15
        ]
      },
      "inOut": {
        "$value": [
          0.65,
          0,
          0.35,
          1
        ]
      },
      "drawer": {
        "$value": [
          0.32,
          0.72,
          0,
          1
        ]
      },
      "linear": {
        "$value": [
          0,
          0,
          1,
          1
        ]
      }
    },
    "spring": {
      "snappy": {
        "$value": {
          "stiffness": 400,
          "damping": 40
        },
        "$type": "spring"
      },
      "gentle": {
        "$value": {
          "stiffness": 200,
          "damping": 30
        },
        "$type": "spring"
      }
    },
    "distance": {
      "$type": "dimension",
      "sm": {
        "$value": 4
      },
      "md": {
        "$value": 8
      },
      "lg": {
        "$value": 16
      }
    },
    "scale": {
      "press": {
        "$value": 0.97,
        "$type": "number"
      },
      "popIn": {
        "$value": 0.96,
        "$type": "number"
      }
    }
  }
}
