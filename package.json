{
  "name": "rangoli-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Agent-first, implementation-neutral design tool",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w @rangoli/editor",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
